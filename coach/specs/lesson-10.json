{
 "lesson": 10,
 "title": "What an API is, and what it is not",
 "artefact": "connect/api-log.md",
 "checks": [
  {
   "type": "urls",
   "file": "connect/api-log.md",
   "min": 1,
   "label": "the API endpoint is recorded"
  },
  {
   "type": "present",
   "file": "connect/api-log.md",
   "patterns": [
    "\\b(200|201|400|401|403|404|429|500)\\b"
   ],
   "label": "a real status code is recorded"
  },
  {
   "type": "present",
   "file": "connect/api-log.md",
   "patterns": [
    "(error|fail|wrong|broken)"
   ],
   "label": "one failure is recorded with its cause"
  },
  {
   "type": "absent",
   "file": "connect/api-log.md",
   "patterns": [
    "sk-[A-Za-z0-9]{16,}"
   ],
   "label": "no key value in the log"
  },
  {
   "type": "present",
   "file": "connect/api-log.md",
   "patterns": [
    "\\{[^}]*\\}"
   ],
   "label": "a response shape is recorded"
  },
  {
   "type": "has_any",
   "file": "connect/api-log.md",
   "any_of": [
    "request",
    "response",
    "header"
   ],
   "label": "the log names the request or the response"
  },
  {
   "type": "words",
   "file": "connect/api-log.md",
   "min": 100,
   "label": "written up in your own words"
  }
 ],
 "manual": [
  "Two real calls were made, and you can say which part of the call was permission and which was the address."
 ]
}