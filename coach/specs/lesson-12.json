{
 "lesson": 12,
 "title": "Clocks: what a cronjob is",
 "artefact": "automate/<job>/",
 "checks": [
  {
   "type": "files",
   "glob": "automate/*/*",
   "min": 2,
   "label": "the job folder holds files"
  },
  {
   "type": "files",
   "glob": "automate/*/*log*",
   "min": 1,
   "label": "a run log exists"
  },
  {
   "type": "has_any",
   "file": "automate/*/*log*",
   "any_of": [
    "06:",
    "07:",
    "AM",
    "PM",
    "cron",
    "daily"
   ],
   "label": "the log shows when it ran"
  },
  {
   "type": "has_any",
   "file": "automate/*/*log*",
   "any_of": [
    "UTC",
    "AEST",
    "AEDT",
    "local",
    "timezone"
   ],
   "label": "the timezone is named"
  },
  {
   "type": "dates",
   "file": "automate/*/*log*",
   "min": 2,
   "label": "two runs are logged"
  },
  {
   "type": "present",
   "file": "automate/*/*log*",
   "patterns": [
    "(fail|error|missed|did not run)"
   ],
   "label": "one deliberate failure is recorded"
  }
 ],
 "manual": [
  "One run was on time and one started by hand."
 ]
}